{
  "version": 1,
  "notes": "Fixed readings and English renderings for Shingeki no Kyojin. The build matches longer forms first, so names and corps stay consistent across episodes.",
  "entries": [
    {"id": "titan", "kind": "term", "forms": ["巨人"], "reading": "きょじん", "english": "Titan", "note": "The human-eating giants. In this series the word is a name, not the ordinary word for a large person."},
    {"id": "colossal", "kind": "term", "forms": ["超大型巨人"], "reading": "ちょうおおがたきょじん", "english": "Colossal Titan", "note": "The enormous Titan that broke Trost's outer gate."},
    {"id": "armored", "kind": "term", "forms": ["鎧の巨人"], "reading": "よろいのきょじん", "english": "Armored Titan"},
    {"id": "female", "kind": "term", "forms": ["女型の巨人"], "reading": "めがたのきょじん", "english": "Female Titan"},
    {"id": "attack-titan", "kind": "term", "forms": ["進撃の巨人"], "reading": "しんげきのきょじん", "english": "Attack Titan", "note": "The Titan's name. The series title in English is Attack on Titan."},
    {"id": "odm", "kind": "term", "forms": ["立体機動装置"], "reading": "りったいきどうそうち", "english": "ODM gear", "note": "Omni-directional mobility gear. The harness and cables soldiers use to move through a city."},
    {"id": "survey", "kind": "term", "forms": ["調査兵団"], "reading": "ちょうさへいだん", "english": "Survey Corps", "note": "The regiment that rides outside the walls."},
    {"id": "garrison", "kind": "term", "forms": ["駐屯兵団"], "reading": "ちゅうとんへいだん", "english": "Garrison Regiment", "note": "The regiment that defends the walls and the towns."},
    {"id": "mp", "kind": "term", "forms": ["憲兵団"], "reading": "けんぺいだん", "english": "Military Police Brigade", "note": "The regiment that keeps order inside the walls."},
    {"id": "training", "kind": "term", "forms": ["訓練兵団"], "reading": "くんれんへいだん", "english": "Training Corps", "note": "The cadet corps. Eren, Mikasa, and Armin trained here together."},
    {"id": "wall", "kind": "term", "forms": ["壁"], "reading": "かべ", "english": "Wall", "note": "In this series, one of the three concentric walls, not an ordinary garden wall."},
    {"id": "maria", "kind": "place", "forms": ["ウォール・マリア"], "reading": "ウォール・マリア", "english": "Wall Maria", "note": "The outermost wall. It has already fallen."},
    {"id": "rose", "kind": "place", "forms": ["ウォール・ローゼ", "ウォール・ローズ"], "reading": "ウォール・ローゼ", "english": "Wall Rose", "note": "The middle wall. Trost is one of its districts."},
    {"id": "sina", "kind": "place", "forms": ["ウォール・シーナ"], "reading": "ウォール・シーナ", "english": "Wall Sina", "note": "The innermost wall."},
    {"id": "shiganshina", "kind": "place", "forms": ["シガンシナ区"], "reading": "シガンシナく", "english": "Shiganshina District"},
    {"id": "trost", "kind": "place", "forms": ["トロスト区"], "reading": "トロストく", "english": "Trost District", "note": "The district whose outer gate is broken in this episode."},
    {"id": "stohess", "kind": "place", "forms": ["ストヘス区"], "reading": "ストヘスく", "english": "Stohess District"},
    {"id": "eren-full", "kind": "character", "forms": ["エレン・イェーガー", "エレン・イエーガー"], "reading": "エレン・イェーガー", "english": "Eren Jaeger"},
    {"id": "eren", "kind": "character", "forms": ["エレン"], "reading": "エレン", "english": "Eren"},
    {"id": "mikasa-full", "kind": "character", "forms": ["ミカサ・アッカーマン"], "reading": "ミカサ・アッカーマン", "english": "Mikasa Ackerman"},
    {"id": "mikasa", "kind": "character", "forms": ["ミカサ"], "reading": "ミカサ", "english": "Mikasa"},
    {"id": "armin-full", "kind": "character", "forms": ["アルミン・アルレルト"], "reading": "アルミン・アルレルト", "english": "Armin Arlert"},
    {"id": "armin", "kind": "character", "forms": ["アルミン"], "reading": "アルミン", "english": "Armin"},
    {"id": "levi", "kind": "character", "forms": ["リヴァイ", "リバイ", "リーヴァイ"], "reading": "リヴァイ", "english": "Levi"},
    {"id": "erwin-full", "kind": "character", "forms": ["エルヴィン・スミス", "エルビン・スミス"], "reading": "エルヴィン・スミス", "english": "Erwin Smith"},
    {"id": "erwin", "kind": "character", "forms": ["エルヴィン", "エルビン"], "reading": "エルヴィン", "english": "Erwin"},
    {"id": "hange-full", "kind": "character", "forms": ["ハンジ・ゾエ", "ハンジ・ゾーエ"], "reading": "ハンジ・ゾエ", "english": "Hange Zoe"},
    {"id": "hange", "kind": "character", "forms": ["ハンジ"], "reading": "ハンジ", "english": "Hange"},
    {"id": "jean-full", "kind": "character", "forms": ["ジャン・キルシュタイン"], "reading": "ジャン・キルシュタイン", "english": "Jean Kirstein"},
    {"id": "jean", "kind": "character", "forms": ["ジャン"], "reading": "ジャン", "english": "Jean"},
    {"id": "connie-full", "kind": "character", "forms": ["コニー・スプリンガー"], "reading": "コニー・スプリンガー", "english": "Connie Springer"},
    {"id": "connie", "kind": "character", "forms": ["コニー"], "reading": "コニー", "english": "Connie"},
    {"id": "sasha-full", "kind": "character", "forms": ["サシャ・ブラウス"], "reading": "サシャ・ブラウス", "english": "Sasha Blouse"},
    {"id": "sasha", "kind": "character", "forms": ["サシャ"], "reading": "サシャ", "english": "Sasha"},
    {"id": "annie-full", "kind": "character", "forms": ["アニ・レオンハート"], "reading": "アニ・レオンハート", "english": "Annie Leonhart"},
    {"id": "annie", "kind": "character", "forms": ["アニ"], "reading": "アニ", "english": "Annie"},
    {"id": "reiner-full", "kind": "character", "forms": ["ライナー・ブラウン"], "reading": "ライナー・ブラウン", "english": "Reiner Braun"},
    {"id": "reiner", "kind": "character", "forms": ["ライナー"], "reading": "ライナー", "english": "Reiner"},
    {"id": "bert-full", "kind": "character", "forms": ["ベルトルト・フーバー"], "reading": "ベルトルト・フーバー", "english": "Bertholdt Hoover"},
    {"id": "bert", "kind": "character", "forms": ["ベルトルト"], "reading": "ベルトルト", "english": "Bertholdt"},
    {"id": "historia-full", "kind": "character", "forms": ["ヒストリア・レイス"], "reading": "ヒストリア・レイス", "english": "Historia Reiss"},
    {"id": "krista", "kind": "character", "forms": ["クリスタ・レンズ", "クリスタ"], "reading": "クリスタ", "english": "Krista Lenz"},
    {"id": "ymir", "kind": "character", "forms": ["ユミル"], "reading": "ユミル", "english": "Ymir"},
    {"id": "pyxis-full", "kind": "character", "forms": ["ドット・ピクシス"], "reading": "ドット・ピクシス", "english": "Dot Pyxis"},
    {"id": "pyxis", "kind": "character", "forms": ["ピクシス"], "reading": "ピクシス", "english": "Pyxis", "note": "Commander of the Garrison in the southern territory."},
    {"id": "cull", "kind": "term", "forms": ["口減らし"], "reading": "くちべらし", "english": "reducing the number of mouths", "note": "A cold political idea: cutting the population because there is not enough food. The episode treats it as a threat, not a plan to copy."},
    {"id": "retake", "kind": "term", "forms": ["奪還"], "reading": "だっかん", "english": "retaking", "note": "Taking back land that was lost. Here, Wall Maria."},
    {"id": "resolve", "kind": "term", "forms": ["覚悟"], "reading": "かくご", "english": "resolve", "note": "The decision to act without a promise of success."},
    {"id": "elite", "kind": "term", "forms": ["精鋭"], "reading": "せいえい", "english": "elites", "note": "The small group of skilled soldiers asked to draw the Titans off Eren's road."},
    {"id": "operation", "kind": "term", "forms": ["作戦"], "reading": "さくせん", "english": "operation", "note": "In this episode, the plan to plug the gate with a boulder."}
  ]
}
