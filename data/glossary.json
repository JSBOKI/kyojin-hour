    {"id": "hange", "kind": "character", "forms": ["ハンジ"], "reading": "ハンジ", "english": "Hange"},
    {"id": "jean-full", "kind": "character", "forms": ["ジャン・キルシュタイン"], "reading": "ジャン・キルシュタイン", "english": "Jean Kirstein"},
    {"id": "jean", "kind": "character", "forms": ["ジャン"], "reading": "ジャン", "english": "Jean"},
    {"id": "connie-full", "kind": "character", "forms": ["コニー・スプリンガー"], "reading": "コニー・スプリンガー", "english": "Connie Springer"},
    {"id": "connie", "kind": "character", "forms": ["コニー"], "reading": "コニー", "english": "Connie"},
    {"id": "sasha-full", "kind": "character", "forms": ["サシャ・ブラウス"], "reading": "サシャ・ブラウス", "english": "Sasha Blouse"},
    {"id": "sasha", "kind": "character", "forms": ["サシャ"], "reading": "サシャ", "english": "Sasha"},
    {"id": "annie-full", "kind": "character", "forms": ["アニ・レオンハート"], "reading": "アニ・レオンハート", "english": "Annie Leonhart"},
    {"id": "annie", "kind": "character", "forms": ["アニ"], "reading": "アニ", "english": "Annie"},
    {"id": "reiner-full", "kind": "character", "forms": ["ライナー・ブラウン"], "reading": "ライナー・ブラウン", "english": "Reiner Braun"},
    {"id": "reiner", "kind": "character", "forms": ["ライナー"], "reading": "ライナー", "english": "Reiner"},
    {"id": "bert-full", "kind": "character", "forms": ["ベルトルト・フーバー"], "reading": "ベルトルト・フーバー", "english": "Bertholdt Hoover"},
    {"id": "bert", "kind": "character", "forms": ["ベルトルト"], "reading": "ベルトルト", "english": "Bertholdt"},
    {"id": "historia-full", "kind": "character", "forms": ["ヒストリア・レイス"], "reading": "ヒストリア・レイス", "english": "Historia Reiss"},
    {"id": "krista", "kind": "character", "forms": ["クリスタ・レンズ", "クリスタ"], "reading": "クリスタ", "english": "Krista Lenz"},
    {"id": "ymir", "kind": "character", "forms": ["ユミル"], "reading": "ユミル", "english": "Ymir"},
    {"id": "pyxis-full", "kind": "character", "forms": ["ドット・ピクシス"], "reading": "ドット・ピクシス", "english": "Dot Pyxis"},
    {"id": "pyxis", "kind": "character", "forms": ["ピクシス"], "reading": "ピクシス", "english": "Pyxis", "note": "Commander of the Garrison in the southern territory."},
    {"id": "cull", "kind": "term", "forms": ["口減らし"], "reading": "くちべらし", "english": "reducing the number of mouths", "note": "A cold political idea: cutting the population because there is not enough food. The episode treats it as a threat, not a plan to copy."},
    {"id": "retake", "kind": "term", "forms": ["奪還"], "reading": "だっかん", "english": "retaking", "note": "Taking back land that was lost. Here, Wall Maria."},
    {"id": "resolve", "kind": "term", "forms": ["覚悟"], "reading": "かくご", "english": "resolve", "note": "The decision to act without a promise of success."},
    {"id": "elite", "kind": "term", "forms": ["精鋭"], "reading": "せいえい", "english": "elites", "note": "The small group of skilled soldiers asked to draw the Titans off Eren's road."},
    {"id": "operation", "kind": "term", "forms": ["作戦"], "reading": "さくせん", "english": "operation", "note": "A planned military action, such as plugging the gate or the expedition beyond the walls."},
    {"id": "ian", "kind": "character", "forms": ["イアン"], "reading": "イアン", "english": "Ian", "note": "Ian Dietrich, a leader of the Garrison elites during the Trost operation."},
    {"id": "mitabi", "kind": "character", "forms": ["ミタビ"], "reading": "ミタビ", "english": "Mitabi", "note": "Mitabi Jarnach, one of the elite squad leaders at Trost."},
    {"id": "rico", "kind": "character", "forms": ["リコ"], "reading": "リコ", "english": "Rico", "note": "Rico Brzenska, the elite leader who lives through the boulder operation."},
    {"id": "marco-full", "kind": "character", "forms": ["マルコ・ボット"], "reading": "マルコ・ボット", "english": "Marco Bott"},
    {"id": "marco", "kind": "character", "forms": ["マルコ"], "reading": "マルコ", "english": "Marco"},
    {"id": "petra-full", "kind": "character", "forms": ["ペトラ・ラル"], "reading": "ペトラ・ラル", "english": "Petra Ral"},
    {"id": "petra", "kind": "character", "forms": ["ペトラ"], "reading": "ペトラ", "english": "Petra"},
    {"id": "oluo-full", "kind": "character", "forms": ["オルオ・ボザド"], "reading": "オルオ・ボザド", "english": "Oluo Bozado"},
    {"id": "oluo", "kind": "character", "forms": ["オルオ"], "reading": "オルオ", "english": "Oluo"},
    {"id": "eld-full", "kind": "character", "forms": ["エルド・ジン"], "reading": "エルド・ジン", "english": "Eld Jinn"},
    {"id": "eld", "kind": "character", "forms": ["エルド"], "reading": "エルド", "english": "Eld"},
    {"id": "gunther-full", "kind": "character", "forms": ["グンター・シュルツ"], "reading": "グンター・シュルツ", "english": "Gunther Schultz"},
    {"id": "gunther", "kind": "character", "forms": ["グンター"], "reading": "グンター", "english": "Gunther"},
    {"id": "nile-full", "kind": "character", "forms": ["ナイール・ドク"], "reading": "ナイール・ドク", "english": "Nile Dok"},
    {"id": "nile", "kind": "character", "forms": ["ナイール"], "reading": "ナイール", "english": "Nile", "note": "Commander of the Military Police Brigade."},
    {"id": "zachary-full", "kind": "character", "forms": ["ダリス・ザックレー"], "reading": "ダリス・ザックレー", "english": "Darius Zachary"},
    {"id": "zachary", "kind": "character", "forms": ["ザックレー"], "reading": "ザックレー", "english": "Zachary", "note": "The officer who presides over Eren's hearing."},
    {"id": "sawney", "kind": "character", "forms": ["ソニー"], "reading": "ソニー", "english": "Sawney", "note": "One of the two Titans Hange keeps for experiments."},
    {"id": "bean", "kind": "character", "forms": ["ビーン"], "reading": "ビーン", "english": "Bean", "note": "The other captured Titan, paired with Sawney."},
    {"id": "levi-squad", "kind": "term", "forms": ["特別作戦班", "リヴァイ班"], "reading": "とくべつさくせんはん", "english": "Special Operations Squad", "note": "Levi's small squad, assigned to watch Eren and, if needed, to kill him."},
    {"id": "captain", "kind": "term", "forms": ["兵長"], "reading": "へいちょう", "english": "Captain", "note": "Levi's rank in the Survey Corps."},
    {"id": "commander", "kind": "term", "forms": ["団長"], "reading": "だんちょう", "english": "Commander", "note": "The officer in charge of a regiment. Erwin is Commander of the Survey Corps."},
    {"id": "abnormal", "kind": "term", "forms": ["奇行種"], "reading": "きこうしゅ", "english": "Abnormal", "note": "A Titan that does not move like the others. On the expedition, one of them is hunting."},
    {"id": "formation-long", "kind": "term", "forms": ["長距離索敵陣形"], "reading": "ちょうきょりさくてきじんけい", "english": "long-range scouting formation", "note": "The wide formation the Survey Corps uses outside the walls so a few soldiers can see danger early."},
    {"id": "formation", "kind": "term", "forms": ["索敵陣形"], "reading": "さくてきじんけい", "english": "scouting formation"},
    {"id": "scout", "kind": "term", "forms": ["索敵"], "reading": "さくてき", "english": "scouting"},
    {"id": "recruit", "kind": "term", "forms": ["新兵"], "reading": "しんぺい", "english": "recruit"},
    {"id": "experiment", "kind": "term", "forms": ["実験"], "reading": "じっけん", "english": "experiment", "note": "Hange's tests on captured Titans, and later on Eren's transformation."},
    {"id": "hearing", "kind": "term", "forms": ["審議"], "reading": "しんぎ", "english": "hearing", "note": "The military hearing that decides who will have custody of Eren."}
  ]
}
